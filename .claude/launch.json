{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nesy/web",
        "dev"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "web-auto",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nesy/web",
        "exec",
        "next",
        "dev"
      ],
      "port": 3103,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nesy/api",
        "dev"
      ],
      "port": 4001
    },
    {
      "name": "web-3102",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nesy/web",
        "exec",
        "next",
        "dev",
        "-p",
        "3102"
      ],
      "port": 3102
    }
  ]
}