{
  "extends": "../typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "noEmit": false
  },
  "include": ["src/index.ts", "src/lib/**/*"],
  "exclude": ["node_modules", "dist", "src/components"]
}
