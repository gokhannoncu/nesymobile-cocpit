generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AutomationRun {
  id          String   @id @default(cuid())
  variantName String
  status      String
  createdAt   DateTime @default(now())
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shipment {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  unloadStatus String   @default("Pending")
  country      String?
  environment  String?
  data         Json

  @@index([country, environment, createdAt])
}

model Pickup {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  pickupType      String   @default("remote")
  shipmentId      String
  assignStatus    String   @default("Pending")
  taskId          String?
  branchId        String?
  courierZoneCode String?
  country         String?
  environment     String?
  data            Json

  @@index([country, environment, createdAt])
}

/// Data Center: Happy Path shipment bundle (pool) — groups generated shipments/pickups
model HappyPathPool {
  id             String   @id @default(uuid())
  name           String
  country        String
  environment    String
  status         String   @default("Draft")
  shipmentCount  Int      @default(0)
  assignmentMode String?
  meta           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entries HappyPathPoolEntry[]

  @@index([country, environment, createdAt])
  @@map("happy_path_pools")
}

/// One generated item inside a Happy Path pool (links to Shipment and/or Pickup rows)
model HappyPathPoolEntry {
  id           String   @id @default(uuid())
  poolId       String
  typeId       String
  label        String
  route        String
  status       String
  shipmentId   String?
  pickupId     String?
  unloadStatus String?
  error        String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  pool HappyPathPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([poolId])
  @@index([shipmentId])
  @@index([pickupId])
  @@map("happy_path_pool_entries")
}

/// Ops / Auth: Nesy kullanıcı ekranından kaydedilen kurye cüzdanı (PIN + hub)
model CourierWallet {
  id          String @id @default(cuid())
  username    String
  password    String /// 4 haneli PIN (Auth sayfasına doldurulur — iç ağı önerilir)
  hubName     String
  hubId       String @default("")
  country     String @default("HR")
  environment String @default("stage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([username, hubId, country, environment])
  @@map("courier_wallets")
}

model MobileDevice {
  id          String   @id @default(cuid())
  deviceId    String   @unique
  adbDeviceId String?
  modelName   String
  product     String?
  transportId String?
  label       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([modelName])
  @@map("mobile_devices")
}

// ─────────────────────────────────────────────────────────────────────────────
// Workflow Automation Models
// ─────────────────────────────────────────────────────────────────────────────

model Workflow {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  status           String   @default("draft")
  category         String?
  icon             String   @default("Workflow")
  iconClassName    String   @default("")
  currentVersionId String?
  draftNodes       Json?
  draftEdges       Json?
  draftConfig      Json?
  draftBaseVersionId String?
  draftUpdatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions WorkflowVersion[]
  runs     WorkflowRun[]

  @@index([status])
  @@index([slug])
  @@map("workflows")
}

model WorkflowVersion {
  id         String   @id @default(cuid())
  workflowId String
  version    Int
  nodes      Json
  edges      Json
  config     Json?
  changelog  String?

  createdAt DateTime @default(now())
  createdBy String?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runs     WorkflowRun[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("workflow_versions")
}

model WorkflowRun {
  id           String  @id @default(cuid())
  workflowId   String
  versionId    String
  status       String  @default("pending")
  mode         String  @default("full")
  targetStepId String?
  deviceId     String?
  country      String?
  environment  String?

  yamlContent   String?
  startedAt     DateTime?
  completedAt   DateTime?
  duration      Int?
  screenshotDir String?
  maestroOutput String?
  /// Span telemetry: array of { name, startMs, durationMs, attrs? } relative to run start
  spans         Json?

  createdAt DateTime @default(now())

  workflow    Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version    WorkflowVersion  @relation(fields: [versionId], references: [id])
  stepResults WorkflowStepResult[]

  @@index([workflowId, createdAt])
  @@index([status])
  @@map("workflow_runs")
}

model WorkflowStepResult {
  id             String    @id @default(cuid())
  runId          String
  nodeId         String
  nodeType       String
  nodeTitle      String
  order          Int
  status         String    @default("pending")
  output         String?
  errorMessage   String?
  screenshotPath String?
  startedAt      DateTime?
  completedAt    DateTime?
  duration       Int?

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, order])
  @@map("workflow_step_results")
}

/// Engineering tools: MongoDB Query Generator history (auto-saved on Generate)
model MongoQueryRun {
  id              String   @id @default(cuid())
  name            String
  naturalLanguage String
  query           String
  database        String
  collection      String
  environment     String
  queryType       String
  country         String?
  status          String
  explanation     Json
  validation      Json
  estimatedScope  Json?
  safetyToggles   Json?
  model           String?
  createdBy       String   @default("local")
  owner           String?
  relatedTicket   String?
  relatedIncident String?
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime @default(now())

  @@index([lastUsedAt])
  @@index([collection])
  @@index([environment])
  @@map("mongo_query_runs")
}

/// Engineering tools: Graylog Query Generator history (auto-saved on Generate)
model GraylogQueryRun {
  id              String   @id @default(cuid())
  name            String
  naturalLanguage String
  query           String
  environment     String
  country         String?
  application     String
  service         String?
  logLevel        String?
  timeRange       String
  device          String?
  appVersion      String?
  identifiers     Json?
  sources         Json?
  status          String
  explanation     Json
  validation      Json
  quality         Json?
  expectedSignals Json?
  summary         String?
  model           String?
  createdBy       String   @default("local")
  relatedIncident String?
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime @default(now())

  @@index([lastUsedAt])
  @@index([environment])
  @@index([country])
  @@map("graylog_query_runs")
}

/// Engineering: Incident Command Center active and historical incident records
model EngineeringIncident {
  id                     String    @id @default(uuid())
  incidentNumber         String    @unique
  title                  String
  summary                String?
  severity               String
  status                 String    @default("ASSESSING")
  objective              String
  countries              String[]
  environment            String
  appVersion             String
  affectedScreen         String
  riskTypes              String[]
  reporterName           String
  incidentCommander      String
  operationsLead         String?
  communicationsLead     String?
  scribe                 String?
  affectedCouriers       Int       @default(0)
  affectedShipments      Int       @default(0)
  affectedPaymentRecords Int       @default(0)
  relatedTicket          String?
  nextCommunicationAt    DateTime?
  resolutionSummary      String?
  rootCause              String?
  startedAt              DateTime  @default(now())
  endedAt                DateTime?
  durationSeconds        Int?
  lastUpdateAt           DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  events EngineeringIncidentEvent[]

  @@index([status, startedAt])
  @@index([endedAt, startedAt])
  @@map("engineering_incidents")
}

/// Engineering: immutable Incident Command Center timeline entries
model EngineeringIncidentEvent {
  id         String   @id @default(uuid())
  incidentId String
  eventType  String
  fromStatus String?
  toStatus   String?
  message    String
  createdBy  String?
  metadata   Json?
  occurredAt DateTime @default(now())

  incident EngineeringIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, occurredAt])
  @@map("engineering_incident_events")
}

/// Automation: field support courier login (1 row per courier / country / env; PIN never stored)
model FieldCourierLogin {
  id               String   @id @default(cuid())
  country          String
  environment      String
  courierUserId    String?
  courierUsername  String?
  courierFullName  String?
  hubId            String?
  hubName          String?
  waybillNumber    String?
  legacyBarcode    String?
  barcode          String?
  deviceCode       String?
  adbDeviceId      String?
  adminUserId      String?
  adminUsername    String?
  status           String
  errorMessage     String?
  failedStep       String?
  maestroRunId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([country, environment, courierUserId])
  @@index([country, environment, updatedAt])
  @@index([status])
  @@index([courierUsername])
  @@map("field_courier_logins")
}
