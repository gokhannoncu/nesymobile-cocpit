generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AutomationRun {
  id          String   @id @default(cuid())
  variantName String
  status      String
  createdAt   DateTime @default(now())
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shipment {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  unloadStatus String   @default("Pending")
  country      String?
  environment  String?
  data         Json

  @@index([country, environment, createdAt])
}

model Pickup {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  pickupType      String   @default("remote")
  shipmentId      String
  assignStatus    String   @default("Pending")
  taskId          String?
  branchId        String?
  courierZoneCode String?
  country         String?
  environment     String?
  data            Json

  @@index([country, environment, createdAt])
}

/// Data Center: Happy Path shipment bundle (pool) — groups generated shipments/pickups
model HappyPathPool {
  id             String   @id @default(uuid())
  name           String
  country        String
  environment    String
  status         String   @default("Draft")
  shipmentCount  Int      @default(0)
  assignmentMode String?
  meta           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entries HappyPathPoolEntry[]

  @@index([country, environment, createdAt])
  @@map("happy_path_pools")
}

/// One generated item inside a Happy Path pool (links to Shipment and/or Pickup rows)
model HappyPathPoolEntry {
  id           String   @id @default(uuid())
  poolId       String
  typeId       String
  label        String
  route        String
  status       String
  shipmentId   String?
  pickupId     String?
  unloadStatus String?
  error        String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  pool HappyPathPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([poolId])
  @@index([shipmentId])
  @@index([pickupId])
  @@map("happy_path_pool_entries")
}

/// Ops / Auth: Nesy kullanıcı ekranından kaydedilen kurye cüzdanı (PIN + hub)
model CourierWallet {
  id          String @id @default(cuid())
  username    String
  password    String /// 4 haneli PIN (Auth sayfasına doldurulur — iç ağı önerilir)
  hubName     String
  hubId       String @default("")
  country     String @default("HR")
  environment String @default("stage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([username, hubId, country, environment])
  @@map("courier_wallets")
}

model MobileDevice {
  id          String   @id @default(cuid())
  deviceId    String   @unique
  adbDeviceId String?
  modelName   String
  product     String?
  transportId String?
  label       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([modelName])
  @@map("mobile_devices")
}

// ─────────────────────────────────────────────────────────────────────────────
// Workflow Automation Models
// ─────────────────────────────────────────────────────────────────────────────

model Workflow {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               String
  description        String?
  status             String    @default("draft")
  category           String?
  icon               String    @default("Workflow")
  iconClassName      String    @default("")
  currentVersionId   String?
  draftNodes         Json?
  draftEdges         Json?
  draftConfig        Json?
  draftBaseVersionId String?
  draftUpdatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions WorkflowVersion[]
  runs     WorkflowRun[]

  @@index([status])
  @@index([slug])
  @@map("workflows")
}

model WorkflowVersion {
  id         String  @id @default(cuid())
  workflowId String
  version    Int
  nodes      Json
  edges      Json
  config     Json?
  changelog  String?

  createdAt DateTime @default(now())
  createdBy String?

  workflow Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runs     WorkflowRun[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("workflow_versions")
}

model WorkflowRun {
  id           String  @id @default(cuid())
  workflowId   String
  versionId    String
  status       String  @default("pending")
  mode         String  @default("full")
  targetStepId String?
  deviceId        String?
  deviceModelName String?
  deviceLabel     String?
  country         String?
  environment     String?

  /// Run-time inputs (barcode, shipmentId, ...) used to resolve parameter tokens.
  /// Lets one workflow run against different shipments without editing the saved version.
  runInput Json?

  startedAt     DateTime?
  completedAt   DateTime?
  duration      Int?
  screenshotDir String?
  /// Span telemetry: array of { name, startMs, durationMs, attrs? } relative to run start
  spans         Json?

  createdAt DateTime @default(now())

  workflow           Workflow                   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version            WorkflowVersion            @relation(fields: [versionId], references: [id])
  stepResults        WorkflowStepResult[]
  diagnosticCaptures VerdictDiagnosticCapture[]
  telemetrySnapshots VerdictRunTelemetrySnapshot[]
  bridgeflowRuntime  BridgeFlowRunRuntime?
  bridgeflowSteps    BridgeFlowStepOccurrence[]
  bridgeflowActions  BridgeFlowActionTransition[]
  bridgeflowWaits    BridgeFlowWaitEvent[]
  bridgeflowFacts    BridgeFlowEvidenceFact[]
  bridgeflowRunBlocks BridgeFlowEvidenceRunBlock[]
  bridgeflowOracle   BridgeFlowOracleEvaluation[]
  testExecutions     VerdictTestExecution[]
  remoteActions      VerdictRemoteActionAttempt[]
  archives           WorkflowRunArchive[]

  @@index([workflowId, createdAt])
  @@index([status])
  @@map("workflow_runs")
}

model WorkflowRunArchive {
  id           String   @id @default(cuid())
  runId        String   @map("run_id")
  artifactKind String   @map("artifact_kind")
  payload      String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, artifactKind], map: "workflow_run_archive_run_kind_key")
  @@index([runId], map: "workflow_run_archive_run_id_idx")
  @@map("workflow_run_archive")
}

model WorkflowStepResult {
  id             String    @id @default(cuid())
  runId          String
  nodeId         String
  nodeType       String
  nodeTitle      String
  order          Int
  status         String    @default("pending")
  output         String?
  errorMessage   String?
  screenshotPath String?
  startedAt      DateTime?
  completedAt    DateTime?
  duration       Int?

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, order])
  @@map("workflow_step_results")
}

/// Host-side D1/D2/D3 diagnostic capture audit (plan B.5.4/B.5.5).
///
/// Rows are written for successful, skipped, and failed attempts. In particular,
/// D3 keeps the requesting actor and explicit opt-in approval even when a disk
/// pre-check prevents the heap dump from starting.
model VerdictDiagnosticCapture {
  id               String    @id @default(cuid())
  captureId        String    @unique @map("capture_id")
  runId            String    @map("run_id")
  sessionId        String    @map("session_id")
  level            String
  triggerEvent     String    @map("trigger_event")
  status           String
  screen           String
  operation        String?
  spanId           String?   @map("span_id")
  pid              Int?
  markerPreMonoTs  String?   @map("marker_pre_mono_ts")
  markerPostMonoTs String?   @map("marker_post_mono_ts")
  artifactRef      String?   @map("artifact_ref")
  mappingFileRef   String?   @map("mapping_file_ref")
  sensitive        Boolean   @default(false)
  skippedReason    String?   @map("skipped_reason")
  errorMessage     String?   @map("error_message")
  buildProfile     String    @map("build_profile")
  requestedBy      String    @map("requested_by")
  optInApprovedBy  String?   @map("opt_in_approved_by")
  optInApprovedAt  DateTime? @map("opt_in_approved_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, screen, operation, spanId], map: "verdict_diagnostic_capture_context_idx")
  @@index([runId, createdAt], map: "verdict_diagnostic_capture_run_created_idx")
  @@index([sensitive, createdAt], map: "verdict_diagnostic_capture_sensitive_idx")
  @@map("verdict_diagnostic_capture")
}

/// Additive, read-only control-plane observations captured during a workflow run.
///
/// This is a child of WorkflowRun because sampling starts only after the Cockpit
/// run/session is established. Cascade deletion keeps telemetry retention aligned
/// with the owning run and prevents orphaned device observations.
model VerdictRunTelemetrySnapshot {
  id               String   @id @default(cuid())
  runId            String   @map("run_id")
  sessionId        String   @map("session_id")
  kind             String
  capturedAt       DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)
  payload          Json
  measurementState String   @default("MEASURED") @map("measurement_state")
  source           String   @default("VERDICT_CONTROL")

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, capturedAt], map: "verdict_run_telemetry_snapshot_run_time_idx")
  @@index([runId, kind, capturedAt], map: "verdict_run_telemetry_snapshot_run_kind_time_idx")
  @@map("verdict_run_telemetry_snapshot")
}

/// Engineering tools: MongoDB Query Generator history (auto-saved on Generate)
model MongoQueryRun {
  id              String   @id @default(cuid())
  name            String
  naturalLanguage String
  query           String
  database        String
  collection      String
  environment     String
  queryType       String
  country         String?
  status          String
  explanation     Json
  validation      Json
  estimatedScope  Json?
  safetyToggles   Json?
  model           String?
  createdBy       String   @default("local")
  owner           String?
  relatedTicket   String?
  relatedIncident String?
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime @default(now())

  @@index([lastUsedAt])
  @@index([collection])
  @@index([environment])
  @@map("mongo_query_runs")
}

/// Engineering tools: Graylog Query Generator history (auto-saved on Generate)
model GraylogQueryRun {
  id              String   @id @default(cuid())
  name            String
  naturalLanguage String
  query           String
  environment     String
  country         String?
  application     String
  service         String?
  logLevel        String?
  timeRange       String
  device          String?
  appVersion      String?
  identifiers     Json?
  sources         Json?
  status          String
  explanation     Json
  validation      Json
  quality         Json?
  expectedSignals Json?
  summary         String?
  model           String?
  createdBy       String   @default("local")
  relatedIncident String?
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime @default(now())

  @@index([lastUsedAt])
  @@index([environment])
  @@index([country])
  @@map("graylog_query_runs")
}

/// Engineering: Incident Command Center active and historical incident records
model EngineeringIncident {
  id                     String    @id @default(uuid())
  incidentNumber         String    @unique
  title                  String
  summary                String?
  severity               String
  status                 String    @default("ASSESSING")
  objective              String
  countries              String[]
  environment            String
  appVersion             String
  affectedScreen         String
  riskTypes              String[]
  reporterName           String
  incidentCommander      String
  operationsLead         String?
  communicationsLead     String?
  scribe                 String?
  affectedCouriers       Int       @default(0)
  affectedShipments      Int       @default(0)
  affectedPaymentRecords Int       @default(0)
  relatedTicket          String?
  nextCommunicationAt    DateTime?
  resolutionSummary      String?
  rootCause              String?
  startedAt              DateTime  @default(now())
  endedAt                DateTime?
  durationSeconds        Int?
  lastUpdateAt           DateTime  @default(now())
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  events EngineeringIncidentEvent[]

  @@index([status, startedAt])
  @@index([endedAt, startedAt])
  @@map("engineering_incidents")
}

/// Engineering: immutable Incident Command Center timeline entries
model EngineeringIncidentEvent {
  id         String   @id @default(uuid())
  incidentId String
  eventType  String
  fromStatus String?
  toStatus   String?
  message    String
  createdBy  String?
  metadata   Json?
  occurredAt DateTime @default(now())

  incident EngineeringIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, occurredAt])
  @@map("engineering_incident_events")
}

/// Automation: field support courier login (1 row per courier / country / env; PIN never stored)
model FieldCourierLogin {
  id              String   @id @default(cuid())
  country         String
  environment     String
  courierUserId   String?
  courierUsername String?
  courierFullName String?
  hubId           String?
  hubName         String?
  waybillNumber   String?
  legacyBarcode   String?
  barcode         String?
  deviceCode      String?
  adbDeviceId     String?
  adminUserId     String?
  adminUsername   String?
  status          String
  errorMessage    String?
  failedStep      String?
  runId           String?  @map("run_id")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([country, environment, courierUserId])
  @@index([country, environment, updatedAt])
  @@index([status])
  @@index([courierUsername])
  @@map("field_courier_logins")
}

// ===========================================================================
//  Verdict at-least-once ingest  (plan C.5.3 / Faz 0.2)
//
//  Three tables, one job: make "the host has durably accepted this event" a
//  fact the device can rely on before it deletes its WAL record.
//
//  The earlier design ACKed right after parsing. If the host then crashed
//  between ACK and fan-out, the device had already dropped the record and the
//  event was gone for good — at-least-once was not achievable. Insert and
//  watermark now move inside ONE transaction, and the ACK is sent only after
//  COMMIT.
//
//  These are written through raw SQL, not the Prisma query builder: the ingest
//  path needs `SELECT ... FOR UPDATE`, array mutation on `pending_above`, and
//  `pg_try_advisory_lock`, none of which Prisma exposes. The models exist so
//  the tables live in the same migration history as everything else.
// ===========================================================================

/// One row per accepted event. PK makes re-delivery idempotent.
model VerdictInbox {
  runId       String    @map("run_id")
  sessionId   String    @map("session_id")
  /// BigInt, not Int: a long-running stream's seq can exceed 2^31.
  seq         BigInt
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  /// NULL until the ordered fan-out worker has handed the event to consumers.
  /// Restart resumes from exactly these rows.
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  /// NULL until the RECEIPT lane has handed the row to its subscribers.
  ///
  /// Separate from `processedAt` on purpose (B.5 / C.40). The receipt lane
  /// publishes committed rows even when they sit above a hole; the ordered lane
  /// may not. One shared timestamp would force one of those two rules to break.
  receiptDispatchedAt DateTime? @map("receipt_dispatched_at") @db.Timestamptz(6)
  /// Ordered-consumer failure count for this row. Persisted rather than kept in
  /// memory so a restart cannot reset a poisonous row's budget and retry it
  /// forever.
  attempt         Int       @default(0)
  /// Last ordered-consumer error. The only diagnosis a dead-lettered row has.
  lastError       String?   @map("last_error")
  /// Earliest permitted ordered retry. NULL = retry immediately.
  nextRetryAt     DateTime? @map("next_retry_at") @db.Timestamptz(6)
  /// Set when the retry budget is exhausted. The ordered lane STOPS here; it is
  /// never skipped, because skipping reorders the stream permanently.
  deadLetteredAt  DateTime? @map("dead_lettered_at") @db.Timestamptz(6)

  @@id([runId, sessionId, seq])
  @@index([runId, sessionId, processedAt, seq], map: "verdict_inbox_pending_idx")
  @@index([runId, sessionId, receiptDispatchedAt, seq], map: "verdict_inbox_receipt_pending_idx")
  @@map("verdict_inbox")
}

/// Evidence closure for one stream — the durable half of the late-event policy.
///
/// Without a persisted answer to "is this run still accepting evidence?", a
/// restarted host cannot distinguish a legitimately late event from an event
/// belonging to a run that ended hours ago, and a closed run's oracle can be
/// re-woken by an event it must ignore.
///
/// Intentionally NOT a relation to `WorkflowRun`: a stream may be closed for
/// evidence purposes while the run row still exists, and the durable runtime
/// must not depend on the run lifecycle table's shape.
model VerdictRunClosure {
  runId          String   @map("run_id")
  sessionId      String   @map("session_id")
  closedAt       DateTime @default(now()) @map("closed_at") @db.Timestamptz(6)
  reason         String
  /// Late events are COUNTED, not dropped. A run that keeps receiving events
  /// after closure means the device never learned the run ended.
  lateEventCount Int      @default(0) @map("late_event_count")

  @@id([runId, sessionId])
  @@map("verdict_run_closure")
}

/// Ranges the device permanently skipped (ENOSPC, capacity, retention purge).
///
/// PK is (run, session, generation), NOT (run, session, from_seq). Generations
/// are immutable on the device: a merge is emitted as a NEW generation rather
/// than a widened old one, so `ON CONFLICT DO NOTHING` cannot silently discard
/// a grown to_seq. Re-sending the same generation is idempotent.
model VerdictGap {
  runId      String   @map("run_id")
  sessionId  String   @map("session_id")
  generation BigInt
  fromSeq    BigInt   @map("from_seq")
  toSeq      BigInt   @map("to_seq")
  reason     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([runId, sessionId, generation])
  @@map("verdict_gap")
}

/// Durable owner of a Verdict run/stream family.
///
/// A device reconnects under its current run secret but may still need to publish
/// committed gaps for an older run. The current secret proves who the socket is;
/// this row proves the older run belongs to the same device and application.
model VerdictStreamOwner {
  runId     String   @id @map("run_id")
  deviceId  String   @map("device_id")
  appId     String   @map("app_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([deviceId, appId], map: "verdict_stream_owner_device_app_idx")
  @@map("verdict_stream_owner")
}

/// Per-stream ingest cursor.
model VerdictStream {
  runId           String   @map("run_id")
  sessionId       String   @map("session_id")
  /// Highest n such that [1..n] is fully covered by received events UNION gaps.
  /// Advanced INCREMENTALLY (see pendingAbove) — never recomputed by scanning
  /// the inbox, which would be O(n^2) per run under the row lock.
  contiguousSeq   BigInt   @default(0) @map("contiguous_seq")
  /// Seqs received above the cursor, i.e. the far side of a hole. A cache, not
  /// a source of truth: losing it costs one full rescan, not correctness.
  pendingAbove    BigInt[] @default([]) @map("pending_above")
  /// Counts how often the 10k pending_above cap forced a full rescan. A
  /// non-zero value in normal operation means the ingest assumptions are wrong.
  fullRescanCount Int      @default(0) @map("full_rescan_count")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([runId, sessionId])
  @@map("verdict_stream")
}

/// Phase 5 BridgeFlow durable runtime manifest and orthogonal run axes.
///
/// BridgeFlow runs pin compiler/domain/profile/runtime metadata here.
/// Older runner payloads are preserved through `WorkflowRunArchive`.
model BridgeFlowRunRuntime {
  id                     String   @id @default(cuid())
  runId                  String   @unique @map("run_id")
  engineType             String   @default("BRIDGEFLOW") @map("engine_type")
  compiledPlanRef        String?  @map("compiled_plan_ref")
  compiledPlanHash       String?  @map("compiled_plan_hash")
  domainPackKey          String?  @map("domain_pack_key")
  domainPackVersion      String?  @map("domain_pack_version")
  domainPackDigest       String?  @map("domain_pack_digest")
  workflowIrSchemaVersion Int?    @map("workflow_ir_schema_version")
  compilerVersion        String?  @map("compiler_version")
  bridgeProtocolVersion  String?  @map("bridge_protocol_version")
  sdkProtocolVersion     String?  @map("sdk_protocol_version")
  runSessionId           String?  @map("run_session_id")
  runEpochMs             BigInt?  @map("run_epoch_ms")
  runEpochUnit           String   @default("MONOTONIC_MS") @map("run_epoch_unit")
  profileSnapshot        Json?    @map("profile_snapshot")
  campaignId             String?  @map("campaign_id")
  buildRef               String?  @map("build_ref")
  datasetRef             String?  @map("dataset_ref")
  deviceCell             String?  @map("device_cell")
  repetitionIndex        Int?     @map("repetition_index")
  faultPlanRef           String?  @map("fault_plan_ref")
  /// G90.9 input axis. Null on every uninjected D30/D90 run. Not observedClass.
  injectedFault          String?  @map("injected_fault")
  expectedClass          String?  @map("expected_class")
  /// G90.9 output axis. Null while uninjected. D60 codes forbidden when injectedFault is null.
  observedClass          String?  @map("observed_class")
  injectedFaultHost      String?  @map("injected_fault_host")
  deathProvenance        String?  @map("death_provenance")
  /// G90.10 injector lifecycle. Independent of observedClass.
  faultProvenance        Json?    @map("fault_provenance")
  telemetryPolicyRef     String?  @map("telemetry_policy_ref")
  releaseGate            Boolean  @default(false) @map("release_gate")
  lifecycle              String   @default("PENDING")
  productVerdict         String   @default("NOT_EVALUATED") @map("product_verdict")
  evaluationFailureClass String   @default("NONE") @map("evaluation_failure_class")
  terminationReason      String   @default("NOT_TERMINATED") @map("termination_reason")
  /// Free-text diagnosis for a run that could not be executed or crashed mid-flight.
  ///
  /// `terminationReason` is a closed axis (`RunTerminationReason`); it cannot carry
  /// "adb forward failed" or a thrown executor message. Without a home for that
  /// text the reason a run failed existed only in the API process stdout, so a
  /// `failed` run was undiagnosable from the cockpit or the database.
  failureDetail          String?  @map("failure_detail")
  /// G90 pre-action state-machine result. Kept separate from product verdict and
  /// the broad evaluation-failure axis so a readiness boundary is never mistaken
  /// for a product defect.
  readinessStatus        String   @default("NOT_REQUIRED") @map("readiness_status")
  readinessClass         String?  @map("readiness_class")
  readinessTrace         Json?    @map("readiness_trace")
  cleanupResult          String   @default("NOT_STARTED") @map("cleanup_result")
  resourceReleaseResult  String   @default("NOT_REQUIRED") @map("resource_release_result")
  schedulerDisposition   String   @default("NOT_SCHEDULED") @map("scheduler_disposition")
  operationalDisposition String   @default("OK") @map("operational_disposition")
  recoveryLeaseToken     String?  @unique(map: "bridgeflow_run_runtime_recovery_token_key") @map("recovery_lease_token")
  recoveryLeaseEpoch     BigInt   @default(0) @map("recovery_lease_epoch")
  recoveryLeaseOwner     String?  @map("recovery_lease_owner")
  recoveryLeaseExpiresAt DateTime? @map("recovery_lease_expires_at") @db.Timestamptz(6)
  recoveryLeaseRenewedAt DateTime? @map("recovery_lease_renewed_at") @db.Timestamptz(6)
  recoveryCheckpointRevision Int @default(0) @map("recovery_checkpoint_revision")
  recoveryCheckpoint     Json?    @map("recovery_checkpoint")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([engineType, createdAt], map: "bridgeflow_run_runtime_engine_created_idx")
  @@index([lifecycle, schedulerDisposition], map: "bridgeflow_run_runtime_state_idx")
  @@index([recoveryLeaseExpiresAt, recoveryLeaseEpoch], map: "bridgeflow_run_runtime_recovery_lease_idx")
  @@map("bridgeflow_run_runtime")
}

/// One durable row per executed plan-step occurrence, including repeated
/// occurrences of the same editor node.
model BridgeFlowStepOccurrence {
  id                 String    @id @default(cuid())
  runId              String    @map("run_id")
  occurrenceId       String    @map("occurrence_id")
  planStepId         String    @map("plan_step_id")
  sourceMapRef       String?   @map("source_map_ref")
  occurrenceIndex    Int       @map("occurrence_index")
  iterationKey       String    @default("root") @map("iteration_key")
  entityRef          Json?     @map("entity_ref")
  requestId          String?   @map("request_id")
  lifecycle          String    @default("PENDING")
  actionResult       String    @default("NOT_STARTED") @map("action_result")
  continueGateResult String    @default("NOT_EVALUATED") @map("continue_gate_result")
  finalOracleResult  String    @default("NOT_EVALUATED") @map("final_oracle_result")
  cleanupResult      String    @default("NOT_STARTED") @map("cleanup_result")
  metadata           Json?
  startedAt          DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, occurrenceId], map: "bridgeflow_step_occurrence_run_occurrence_key")
  @@index([runId, planStepId, occurrenceIndex], map: "bridgeflow_step_occurrence_step_idx")
  @@index([runId, iterationKey], map: "bridgeflow_step_occurrence_iteration_idx")
  @@map("bridgeflow_step_occurrence")
}

/// Per-attempt physical action transition log.
model BridgeFlowActionTransition {
  id           String   @id @default(cuid())
  runId        String   @map("run_id")
  occurrenceId String   @map("occurrence_id")
  requestId    String   @map("request_id")
  phase        String
  atMs         BigInt   @map("at_ms")
  evidenceRef  String?  @map("evidence_ref")
  terminal     String?
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, occurrenceId, requestId, phase], map: "bridgeflow_action_transition_phase_key")
  @@index([runId, occurrenceId, requestId, atMs], map: "bridgeflow_action_transition_request_idx")
  @@map("bridgeflow_action_transition")
}

/// wait_any/cancel_request routing result, one terminal result per occurrence.
model BridgeFlowWaitEvent {
  id            String   @id @default(cuid())
  runId         String   @map("run_id")
  occurrenceId  String   @map("occurrence_id")
  waitPlanId    String?  @map("wait_plan_id")
  requestId     String?  @map("request_id")
  status        String
  resultKey     String?  @map("result_key")
  cancelStatus  String?  @map("cancel_status")
  terminalAt    DateTime @default(now()) @map("terminal_at") @db.Timestamptz(6)
  metadata      Json?

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, occurrenceId, waitPlanId], map: "bridgeflow_wait_event_one_terminal_key")
  @@index([runId, status], map: "bridgeflow_wait_event_status_idx")
  @@map("bridgeflow_wait_event")
}

/// Normalized semantic fact with raw audit and evidence journey state.
model BridgeFlowEvidenceFact {
  id                 String   @id @default(cuid())
  runId              String   @map("run_id")
  occurrenceId       String   @map("occurrence_id")
  iterationKey       String   @default("root") @map("iteration_key")
  factKey            String   @map("fact_key")
  revision           Int      @default(1)
  idempotencyKey     String   @map("idempotency_key")
  plane              String
  sourceSubtype      String   @map("source_subtype")
  value              Json
  authority          String
  deliveryLane       String   @map("delivery_lane")
  rawEventRef        String?  @map("raw_event_ref")
  reducerTrace       Json?    @map("reducer_trace")
  freshnessMaxAgeMs  Int?     @map("freshness_max_age_ms")
  correlationStatus  String   @default("PENDING") @map("correlation_status")
  journeyStage       String   @default("INBOX") @map("journey_stage")
  journeyState       String   @default("PENDING") @map("journey_state")
  observedAt         DateTime @default(now()) @map("observed_at") @db.Timestamptz(6)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, idempotencyKey], map: "bridgeflow_evidence_fact_idempotency_key")
  @@unique([runId, occurrenceId, iterationKey, factKey, deliveryLane, revision], map: "bridgeflow_evidence_fact_revision_key")
  @@index([runId, occurrenceId, iterationKey, factKey], map: "bridgeflow_evidence_fact_correlation_idx")
  @@index([runId, plane, sourceSubtype], map: "bridgeflow_evidence_fact_source_idx")
  @@map("bridgeflow_evidence_fact")
}

/// Durable poison/block observation when ordered evidence cannot be scoped to an occurrence.
model BridgeFlowEvidenceRunBlock {
  id             String   @id @default(cuid())
  runId          String   @map("run_id")
  idempotencyKey String   @map("idempotency_key")
  reason         String
  evidenceRef    String?  @map("evidence_ref")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, idempotencyKey], map: "bridgeflow_evidence_run_block_idempotency_key")
  @@index([runId, createdAt], map: "bridgeflow_evidence_run_block_run_idx")
  @@map("bridgeflow_evidence_run_block")
}

/// Continue Gate and Final Oracle v2 evaluation read model.
model BridgeFlowOracleEvaluation {
  id                     String   @id @default(cuid())
  runId                  String   @map("run_id")
  occurrenceId           String   @map("occurrence_id")
  evaluatorKind          String   @map("evaluator_kind")
  revision               Int      @default(1)
  idempotencyKey         String   @map("idempotency_key")
  outcome                String
  productVerdict         String?  @map("product_verdict")
  evaluationFailureClass String?  @map("evaluation_failure_class")
  requirements           Json?
  evidenceRefs           Json?    @map("evidence_refs")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, idempotencyKey], map: "bridgeflow_oracle_evaluation_idempotency_key")
  @@unique([runId, occurrenceId, evaluatorKind, revision], map: "bridgeflow_oracle_evaluation_revision_key")
  @@index([runId, occurrenceId, evaluatorKind], map: "bridgeflow_oracle_evaluation_occurrence_idx")
  @@map("bridgeflow_oracle_evaluation")
}

/// Phase 5 TestExecutionQueue foundation.
model VerdictTestExecution {
  id                   String    @id @default(cuid())
  executionId          String    @unique @map("execution_id")
  runId                String    @map("run_id")
  lifecycle            String    @default("PENDING")
  productVerdict       String    @default("NOT_EVALUATED") @map("product_verdict")
  schedulerDisposition String    @default("NOT_SCHEDULED") @map("scheduler_disposition")
  disposition          String    @default("BLOCKED")
  recoveryState        String?   @map("recovery_state")
  manifest             Json?
  leaseOwner           String?   @map("lease_owner")
  leaseExpiresAt       DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  heartbeatAt          DateTime? @map("heartbeat_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([lifecycle, schedulerDisposition], map: "verdict_test_execution_state_idx")
  @@index([leaseExpiresAt, heartbeatAt], map: "verdict_test_execution_recovery_idx")
  @@map("verdict_test_execution")
}

/// Phase 5 TestDataBroker + device-command admission lease foundation.
/// `runId` is an opaque owner id (BridgeFlow or Maestro) — not an FK into
/// `workflow_runs`, so admission leases can outlive / precede that table.
model VerdictResourceLease {
  id                   String    @id @default(cuid())
  leaseId              String    @unique @map("lease_id")
  runId                String    @map("run_id")
  resourceId           String    @map("resource_id")
  conflictGroup        String    @map("conflict_group")
  exclusive            Boolean   @default(true)
  state                String    @default("DIRTY")
  reconciliationReason String?   @map("reconciliation_reason")
  leasedAt             DateTime  @default(now()) @map("leased_at") @db.Timestamptz(6)
  expiresAt            DateTime? @map("expires_at") @db.Timestamptz(6)
  releasedAt           DateTime? @map("released_at") @db.Timestamptz(6)

  @@index([conflictGroup, state], map: "verdict_resource_lease_conflict_idx")
  @@index([runId, state], map: "verdict_resource_lease_run_state_idx")
  @@index([resourceId, conflictGroup, state], map: "verdict_resource_lease_resource_conflict_idx")
  @@map("verdict_resource_lease")
}

/// Remote action runtime foundation. Success here is transport/action status;
/// Final Oracle still owns business verdict.
model VerdictRemoteActionAttempt {
  id              String    @id @default(cuid())
  runId           String    @map("run_id")
  occurrenceId    String    @map("occurrence_id")
  operationRef    String    @map("operation_ref")
  idempotencyKey  String    @map("idempotency_key")
  effectClass     String    @map("effect_class")
  timeoutMs       Int       @map("timeout_ms")
  status          String    @default("PENDING")
  resourceLeaseId String?   @map("resource_lease_id")
  requestPayload  Json?     @map("request_payload")
  responsePayload Json?     @map("response_payload")
  errorMessage    String?   @map("error_message")
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, occurrenceId, operationRef, idempotencyKey], map: "verdict_remote_action_idempotency_key")
  @@index([runId, status], map: "verdict_remote_action_status_idx")
  @@map("verdict_remote_action_attempt")
}

/// Stable Domain Pack identity. Version snapshots are append-only children.
/// Durable record of an accepted workflow run start.
///
/// This is deliberately not `bridgeflow_run_runtime`: that table is keyed to an
/// existing `workflow_runs` row by foreign key, while a run start is accepted
/// before any such row exists. `idempotencyKey` is the composed
/// workflowRef|deviceId|planHash|profileKey|profileVersion tuple, so a retried
/// start returns the original run instead of queueing a second execution.
model VerdictRunStart {
  id                String   @id @default(cuid())
  idempotencyKey    String   @unique @map("idempotency_key")
  runId             String   @unique @map("run_id")
  executionId       String   @map("execution_id")
  workflowRef       String   @map("workflow_ref")
  deviceId          String   @map("device_id")
  compiledPlanRef   String   @map("compiled_plan_ref")
  compiledPlanHash  String   @map("compiled_plan_hash")
  domainPackKey     String   @map("domain_pack_key")
  domainPackVersion String   @map("domain_pack_version")
  domainPackDigest  String   @map("domain_pack_digest")
  releaseGate       Boolean  @default(false) @map("release_gate")
  profileKey        String?  @map("profile_key")
  profileVersion    String?  @map("profile_version")
  status            String   @default("QUEUED")
  engineType        String   @default("BRIDGEFLOW") @map("engine_type")
  injectedFault     String?  @map("injected_fault")
  expectedClass     String?  @map("expected_class")
  injectedFaultHost String?  @map("injected_fault_host")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workflowRef, deviceId], map: "verdict_run_start_workflow_device_idx")
  @@map("verdict_run_start")
}

/// Durable BridgeFlow compiled plan store.
///
/// A run start pins `compiledPlanRef` + `compiledPlanHash`; this table stores
/// the immutable plan body so an API restart or a second API process can execute
/// exactly the plan that was previewed.
model VerdictCompiledPlan {
  id                String   @id @default(cuid())
  planRef           String   @unique @map("plan_ref")
  planHash          String   @unique @map("plan_hash")
  workflowRef       String   @map("workflow_ref")
  domainPackKey     String   @map("domain_pack_key")
  domainPackVersion String   @map("domain_pack_version")
  domainPackDigest  String   @map("domain_pack_digest")
  compilerVersion   String   @map("compiler_version")
  plan              Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workflowRef, createdAt], map: "verdict_compiled_plan_workflow_idx")
  @@index([domainPackKey, domainPackVersion], map: "verdict_compiled_plan_pack_idx")
  @@map("verdict_compiled_plan")
}

/// Append-only interaction stream consumed by the Run Detail live view through a
/// monotonic per-run revision cursor. Summaries are redacted before insert.
model VerdictRunInteraction {
  id             String   @id @default(cuid())
  runId          String   @map("run_id")
  eventId        String   @map("event_id")
  revision       Int
  origin         String
  confidence     Int
  occurredAtMs   BigInt   @map("occurred_at_ms")
  summary        String
  secretRedacted Boolean  @default(true) @map("secret_redacted")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([runId, revision], map: "verdict_run_interaction_revision_key")
  @@unique([runId, eventId], map: "verdict_run_interaction_event_key")
  @@index([runId, revision], map: "verdict_run_interaction_cursor_idx")
  @@map("verdict_run_interaction")
}

model VerdictDomainPack {
  id        String   @id @default(cuid())
  packKey   String   @unique @map("pack_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions VerdictDomainPackVersion[]

  @@map("verdict_domain_pack")
}

/// Versioned Domain Pack bundle snapshot. Once `publicationState` is PUBLISHED,
/// the database migration rejects updates and deletes; changes require a new row.
model VerdictDomainPackVersion {
  id               String    @id @default(cuid())
  domainPackId     String    @map("domain_pack_id")
  version          String
  bundleDigest     String    @map("bundle_digest")
  publicationState String    @default("DRAFT") @map("publication_state")
  bundle           Json
  /// Optimistic-concurrency counter for draft-save and publish.
  revision         Int       @default(1)
  immutableAt      DateTime? @map("immutable_at") @db.Timestamptz(6)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy      String?   @map("published_by")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  domainPack   VerdictDomainPack           @relation(fields: [domainPackId], references: [id], onDelete: Restrict)
  testProfiles VerdictTestProfileVersion[]
  campaigns    VerdictTestCampaign[]

  @@unique([domainPackId, version], map: "verdict_domain_pack_version_key")
  @@unique([domainPackId, bundleDigest], map: "verdict_domain_pack_digest_key")
  @@index([publicationState, createdAt], map: "verdict_domain_pack_publication_idx")
  @@map("verdict_domain_pack_version")
}

/// Versioned Test Profile definition snapshot used by later catalog APIs.
model VerdictTestProfileVersion {
  id                  String   @id @default(cuid())
  profileKey          String   @map("profile_key")
  version             Int
  domainPackVersionId String?  @map("domain_pack_version_id")
  definition          Json
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  domainPackVersion VerdictDomainPackVersion? @relation(fields: [domainPackVersionId], references: [id], onDelete: Restrict)

  @@unique([profileKey, version], map: "verdict_test_profile_version_key")
  @@index([domainPackVersionId], map: "verdict_test_profile_pack_version_idx")
  @@map("verdict_test_profile_version")
}

/// One durable execution of a versioned Test Campaign definition.
model VerdictTestCampaign {
  id                  String    @id @default(cuid())
  campaignId          String    @unique @map("campaign_id")
  campaignKey         String    @map("campaign_key")
  campaignVersion     Int       @map("campaign_version")
  domainPackVersionId String?   @map("domain_pack_version_id")
  definition          Json
  status              String    @default("PENDING")
  failedCells         Json?     @map("failed_cells")
  releaseGateResult   String?   @map("release_gate_result")
  evidenceSummaryRef  String?   @map("evidence_summary_ref")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)

  domainPackVersion VerdictDomainPackVersion? @relation(fields: [domainPackVersionId], references: [id], onDelete: Restrict)
  cells             VerdictCampaignCell[]

  @@index([campaignKey, campaignVersion], map: "verdict_test_campaign_version_idx")
  @@index([status, createdAt], map: "verdict_test_campaign_status_idx")
  @@map("verdict_test_campaign")
}

/// One profile/build/device/repetition cell within a durable campaign.
model VerdictCampaignCell {
  id                 String   @id @default(cuid())
  campaignId         String   @map("campaign_id")
  cellKey            String   @map("cell_key")
  profileKey         String   @map("profile_key")
  profileVersion     Int      @map("profile_version")
  buildRef           String?  @map("build_ref")
  environment        String?
  deviceCell         String?  @map("device_cell")
  repetitionIndex    Int      @default(0) @map("repetition_index")
  runIds             Json     @map("run_ids")
  result             String   @default("PENDING")
  blockedReason      String?  @map("blocked_reason")
  evidenceSummaryRef String?  @map("evidence_summary_ref")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign VerdictTestCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, cellKey], map: "verdict_campaign_cell_key")
  @@index([profileKey, profileVersion], map: "verdict_campaign_cell_profile_idx")
  @@index([result, updatedAt], map: "verdict_campaign_cell_result_idx")
  @@map("verdict_campaign_cell")
}
