{
  "name": "@nesy/bridge-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Verdict Bridge host TAŞIMASI — NDJSON/TCP client, pending request map, timeout/cancel, bağlantı kaybı sınıflandırması. bridge-contract'a bağımlıdır, TERSİ ASLA (D.3).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./fake": {
      "import": "./dist/fake-bridge-server.js",
      "types": "./dist/fake-bridge-server.d.ts"
    }
  },
  "dependencies": {
    "@nesy/bridge-contract": "workspace:*"
  },
  "devDependencies": {
    "@nesy/eslint-config": "workspace:*",
    "@nesy/typescript-config": "workspace:*",
    "@types/node": "^22.10.10",
    "eslint": "^9.39.1",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
