{
  "name": "nesy-mobile-cockpit",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "predev": "node scripts/kill-dev-ports.mjs",
    "dev": "node scripts/cockpit-runner.mjs --mode dev",
    "preprod": "node scripts/kill-dev-ports.mjs",
    "prod": "node scripts/cockpit-runner.mjs --mode prod",
    "prefastprod": "node scripts/kill-dev-ports.mjs",
    "fastprod": "node scripts/cockpit-runner.mjs --mode fastprod",
    "rebuild:web": "pnpm --filter @nesy/web build",
    "rebuild:api": "pnpm --filter @nesy/api build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck",
    "verdict:verify-master-plan": "node scripts/verify-master-plan.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
