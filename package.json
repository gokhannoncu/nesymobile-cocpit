{
  "name": "nesy-mobile-cockpit",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "predev": "node scripts/kill-dev-ports.mjs",
    "dev": "node scripts/cockpit-runner.mjs --mode dev",
    "preprod": "node scripts/kill-dev-ports.mjs",
    "prod": "node scripts/cockpit-runner.mjs --mode prod",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
