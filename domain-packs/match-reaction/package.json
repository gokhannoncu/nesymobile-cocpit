{
  "name": "@nesy/match-reaction-domain-pack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Second-domain proof pack for app-agnostic Verdict contracts.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
