          "next": null,
          "timeoutMs": 20000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [],
          "kind": "CONDITION",
          "condition": {
            "kind": "comparison",
            "operator": "in",
