        },
        {
          "name": "rowHandle",
          "type": "string"
        },
        {
          "name": "confirmHandle",
          "type": "string"
        }
      ],
      "steps": [
        {
          "planStepId": "wait-dialog",
          "sourceMapRef": "sm-route-1",
          "next": "read-offered-routes",
          "timeoutMs": 20000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [],
          "kind": "WAIT_EVENT",
          "factKey": "UI.ROUTE_DIALOG_READY",
          "sourceLane": "UI",
          "stableForMs": 200,
          "requireCorrelation": false,
          "onTimeout": "FAIL"
        },
        {
          "planStepId": "read-offered-routes",
          "sourceMapRef": "sm-route-2",
          "next": "check-offered",
