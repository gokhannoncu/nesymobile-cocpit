          "factKey": "APP.SELECTED_ROUTE_OBSERVED",
          "expected": true,
          "unknownPolicy": "FAIL",
          "entityBinding": {
            "type": "ROUTE",
            "id": "run.input.routeCode"
          },
          "finalOraclePolicy": {
            "requirements": [
              {
                "factKey": "APP.SELECTED_ROUTE_OBSERVED",
