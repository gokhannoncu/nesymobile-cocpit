          "planStepId": "tap-confirm",
          "sourceMapRef": "sm-route-8",
          "next": "verify-assignment",
          "timeoutMs": 25000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [
            {
              "capability": "verdict.core.bridge.tap",
              "optional": false
            }
          ],
          "kind": "BRIDGE_ACTION",
          "action": "tap",
          "targetVariable": "confirmHandle",
          "continueGate": {
            "allOf": [
              "UI.ROUTE_LIST_READY",
              "APP.AVAILABLE_STOPS_LOADED"
            ],
            "deadlineMs": 25000,
            "unknownPolicy": "RETRY"
          }
        },
        {
          "planStepId": "verify-assignment",
          "sourceMapRef": "sm-route-9",
          "next": "assert-selection",
          "timeoutMs": 30000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [
