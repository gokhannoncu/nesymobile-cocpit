          "next": "tap-row",
          "timeoutMs": 20000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [
            {
              "capability": "verdict.core.bridge.resolve-target",
              "optional": false
            }
          ],
          "kind": "RESOLVE_TARGET",
          "targetRef": "nesy.target.route-row",
          "outputVariable": "rowHandle",
          "entityBinding": {
            "type": "ROUTE",
            "id": "run.input.routeCode"
          }
        },
        {
          "planStepId": "tap-row",
          "sourceMapRef": "sm-route-6",
          "next": "resolve-confirm",
          "timeoutMs": 20000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [
            {
              "capability": "verdict.core.bridge.tap",
              "optional": false
            }
          ],
          "kind": "BRIDGE_ACTION",
          "action": "tap",
          "targetVariable": "rowHandle",
          "entityBinding": {
            "type": "ROUTE",
            "id": "run.input.routeCode"
          }
        },
        {
          "planStepId": "resolve-confirm",
          "sourceMapRef": "sm-route-7",
          "next": "tap-confirm",
          "timeoutMs": 20000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
