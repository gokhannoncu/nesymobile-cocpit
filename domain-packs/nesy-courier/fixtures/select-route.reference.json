              "kind": "operand",
              "source": "run.input",
              "path": "routeCode"
            },
            "right": {
              "kind": "operand",
              "source": "step.output",
              "path": "read-offered-routes.codes"
            }
          },
          "onTrue": "resolve-row",
          "onFalse": "report-not-offered",
          "unknownPolicy": "FAIL"
        },
        {
          "planStepId": "report-not-offered",
          "sourceMapRef": "sm-route-4",
          "next": null,
          "timeoutMs": 20000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [],
