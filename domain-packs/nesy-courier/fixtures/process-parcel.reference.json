{
  "sliceKey": "PROCESS_PARCEL",
  "displayName": "Process parcel",
  "businessMeaning": "A courier scans one parcel at the current stop and the app accepts and records it, both in memory and on the device.",
  "notResponsibleFor": [
    "camera hardware, focus or lighting — the payload is injected, so optical scanning is out of scope by construction",
    "the delivery outcome for the parcel (see COMPLETE_DELIVERY)",
    "payment or fiscal receipt handling",
    "backend reconciliation of the scan"
  ],
  "inputSchema": {
    "fields": [
      {
        "name": "scanPayload",
        "type": "string",
        "required": true,
        "description": "The value the scanner is told it read."
      },
      {
        "name": "task",
        "type": "entityRef",
        "required": true,
        "entityTypeRef": "TASK"
      }
    ]
  },
  "outputSchema": {
    "fields": [
      {
        "name": "itemAccepted",
        "type": "boolean",
        "factKey": "APP.PARCEL_SCANNED"
      },
      {
        "name": "itemProcessed",
        "type": "boolean",
        "factKey": "APP.PARCEL_STATE_PROCESSED"
      }
    ]
  },
  "preconditions": [
    {
      "kind": "FACT_TRUE",
      "ref": "APP.ACTIVE_STOP_MATCHES",
      "deadlineMs": 20000,
      "onUnmet": "FAIL"
    },
    {
      "kind": "SCREEN_READY",
      "ref": "nesy.delivery.flow",
      "deadlineMs": 20000,
      "onUnmet": "FAIL"
    },
    {
      "kind": "FACT_TRUE",
      "ref": "APP.SESSION_ISOLATION_ASSERTED",
      "deadlineMs": 10000,
      "onUnmet": "FAIL"
    }
  ],
  "screenRefs": [
    "nesy.delivery.flow",
    "nesy.stop.task-list"
  ],
  "surfaceRefs": [
    "nesy.scanner.surface"
  ],
  "entityBindings": [
    {
      "entityTypeRef": "PARCEL",
      "role": "Correlates the injected payload with the app's own scan event."
    },
    {
      "entityTypeRef": "TASK",
      "role": "Scopes the scan to the task under test."
    }
  ],
  "targetResolutionRefs": [
    "nesy.target.scan-trigger"
  ],
  "semanticMacroRef": "nesy.macro.process-parcel",
  "macroExpansion": {
    "macroRef": "nesy.macro.process-parcel",
    "authoredBy": "HAND",
    "genericIr": {
      "schemaVersion": 2,
      "workflowId": "nesy.reference.process-parcel",
      "workflowVersion": 1,
      "name": "Scan and process one parcel",
      "source": {
        "kind": "DOMAIN_PACK_EXPANSION",
        "ref": "nesy.macro.process-parcel"
      },
      "inputs": [
        {
          "name": "scanPayload",
          "type": "string",
          "required": true,
          "secret": false
        },
        {
          "name": "taskCode",
          "type": "string",
          "required": true
        }
      ],
      "variables": [
        {
          "name": "triggerHandle",
          "type": "string"
        },
        {
          "name": "itemStateRows",
          "type": "stringList"
        }
      ],
      "steps": [
        {
          "planStepId": "wait-scanner",
          "sourceMapRef": "sm-scan-1",
          "next": "resolve-trigger",
          "timeoutMs": 20000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [],
          "kind": "WAIT_EVENT",
          "factKey": "UI.SCANNER_SURFACE_READY",
          "sourceLane": "UI",
          "stableForMs": 200,
          "requireCorrelation": false,
          "onTimeout": "FAIL"
        },
        {
          "planStepId": "resolve-trigger",
          "sourceMapRef": "sm-scan-2",
          "next": "inject-payload",
          "timeoutMs": 20000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [
            {
              "capability": "verdict.core.bridge.resolve-target",
              "optional": false
            }
          ],
          "kind": "RESOLVE_TARGET",
          "targetRef": "nesy.target.scan-trigger",
          "outputVariable": "triggerHandle"
        },
        {
          "planStepId": "inject-payload",
          "sourceMapRef": "sm-scan-3",
          "next": "await-accepted",
          "timeoutMs": 20000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "IDEMPOTENT_MUTATION"
          },
          "capabilityRequirements": [
            {
              "capability": "domain.nesy.scanner.inject",
              "optional": false
            }
          ],
          "kind": "REMOTE_ACTION",
          "spec": {
            "adapterRef": "nesy.courier.app-adapter",
            "operationRef": "nesy.setup.scanner-inject",
            "role": "SETUP",
            "effectClass": "IDEMPOTENT_MUTATION",
            "idempotencyClass": "KEYED",
            "idempotencyKey": "run.input.scanPayload",
            "inputBindings": [
              {
                "name": "scanPayload",
                "source": {
                  "kind": "runInput",
                  "path": "scanPayload"
                }
              }
            ],
            "outputFactBindings": [],
            "timeoutPolicy": {
              "timeoutMs": 15000,
              "maxAttempts": 1
            },
            "reconciliationPolicy": "RECONCILE_ON_UNKNOWN",
            "auditPolicy": {
              "recordRequest": true,
              "recordResponse": true,
              "redactFields": [
                "scanPayload"
              ]
            },
            "allowedEnvironments": [
              "qa",
              "automation"
            ]
          }
        },
        {
          "planStepId": "await-accepted",
          "sourceMapRef": "sm-scan-4",
          "next": "read-item-state",
          "timeoutMs": 25000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [],
          "kind": "WAIT_EVENT",
          "factKey": "APP.PARCEL_SCANNED",
          "sourceLane": "APP",
          "requireCorrelation": true,
          "onTimeout": "FAIL",
          "entityBinding": {
            "type": "PARCEL",
            "id": "run.input.scanPayload"
          },
          "continueGate": {
            "allOf": [
              "APP.PARCEL_SCANNED"
            ],
            "deadlineMs": 25000,
            "unknownPolicy": "RETRY"
          }
        },
        {
          "planStepId": "read-item-state",
          "sourceMapRef": "sm-scan-5",
          "next": "assert-processed",
          "timeoutMs": 20000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [
            {
              "capability": "domain.nesy.adapter.named-query",
              "optional": false
            }
          ],
          "kind": "SDK_QUERY",
          "queryRef": "nesy.parcelState",
          "maxRows": 20,
          "outputVariable": "itemStateRows"
        },
        {
          "planStepId": "assert-processed",
          "sourceMapRef": "sm-scan-6",
          "next": null,
          "timeoutMs": 20000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [],
          "kind": "ASSERT_FACT",
          "factKey": "APP.PARCEL_STATE_PROCESSED",
          "expected": true,
          "unknownPolicy": "FAIL",
          "entityBinding": {
            "type": "PARCEL",
            "id": "run.input.scanPayload"
          },
          "finalOraclePolicy": {
            "requirements": [
              {
                "factKey": "APP.PARCEL_STATE_PROCESSED",
                "obligation": "REQUIRED",
                "timing": "IMMEDIATE",
                "onTimeout": "FAIL"
              },
