  "negativeCases": [
    {
      "caseKey": "INJECTION_AS_ITS_OWN_EVIDENCE",
      "scenario": "The injection operation binds a fact meaning 'a scan happened'. The run then proves that the harness called the adapter, not that the app processed anything.",
      "refusedBy": "The operation has role SETUP with no outputFactBindings; validateExternalAction raises SETUP_PRODUCES_VERDICT if setup binds facts, and validateRemoteAdapterOperation raises SETUP_BINDS_BUSINESS_FACT for the adapter twin."
    },
