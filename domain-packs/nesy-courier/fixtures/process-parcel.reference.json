          "compensatesStepIds": [
            "inject-payload"
          ],
          "runOnFailure": true
        }
      ],
      "entryStepId": "wait-scanner",
      "policies": {
        "runDeadlineMs": 600000,
        "cleanupDeadlineMs": 60000,
        "defaultRetry": {
          "maxAttempts": 1,
          "effectClass": "READ_ONLY"
        },
        "artifactPolicy": {
          "captureOnSuccess": false,
