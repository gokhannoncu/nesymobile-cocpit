                "timing": "EVENTUAL",
                "deadlineMs": 30000,
                "onTimeout": "INCONCLUSIVE"
              },
              {
                "factKey": "APP.SESSION_ISOLATION_ASSERTED",
                "obligation": "REQUIRED",
                "timing": "IMMEDIATE",
                "onTimeout": "FAIL"
              }
            ]
          }
        },
        {
          "planStepId": "clear-injection",
