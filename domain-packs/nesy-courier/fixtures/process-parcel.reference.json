{
  "sliceKey": "PROCESS_PARCEL",
  "displayName": "Process parcel",
  "businessMeaning": "A courier scans one parcel at the current stop and the app accepts and records it, both in memory and on the device.",
  "notResponsibleFor": [
    "camera hardware, focus or lighting — the payload is injected, so optical scanning is out of scope by construction",
    "the delivery outcome for the parcel (see COMPLETE_DELIVERY)",
    "payment or fiscal receipt handling",
    "backend reconciliation of the scan"
  ],
  "inputSchema": {
    "fields": [
      {
        "name": "scanPayload",
        "type": "string",
        "required": true,
        "description": "The value the scanner is told it read."
      },
      {
        "name": "task",
        "type": "entityRef",
        "required": true,
        "entityTypeRef": "TASK"
      }
    ]
  },
  "outputSchema": {
    "fields": [
      {
        "name": "itemAccepted",
        "type": "boolean",
        "factKey": "APP.PARCEL_SCANNED"
      },
      {
        "name": "itemProcessed",
        "type": "boolean",
        "factKey": "APP.PARCEL_STATE_PROCESSED"
      }
    ]
  },
  "preconditions": [
    {
      "kind": "FACT_TRUE",
      "ref": "APP.ACTIVE_STOP_MATCHES",
      "deadlineMs": 20000,
      "onUnmet": "FAIL"
    },
    {
      "kind": "SCREEN_READY",
      "ref": "nesy.delivery.flow",
      "deadlineMs": 20000,
      "onUnmet": "FAIL"
    },
    {
      "kind": "FACT_TRUE",
      "ref": "APP.SESSION_ISOLATION_ASSERTED",
      "deadlineMs": 10000,
      "onUnmet": "FAIL"
    }
  ],
  "screenRefs": [
    "nesy.delivery.flow",
    "nesy.stop.task-list"
  ],
  "surfaceRefs": [
    "nesy.scanner.surface"
  ],
  "entityBindings": [
    {
      "entityTypeRef": "PARCEL",
      "role": "Correlates the injected payload with the app's own scan event."
    },
    {
      "entityTypeRef": "TASK",
      "role": "Scopes the scan to the task under test."
    }
  ],
  "targetResolutionRefs": [
    "nesy.target.scan-trigger"
  ],
  "semanticMacroRef": "nesy.macro.process-parcel",
  "macroExpansion": {
    "macroRef": "nesy.macro.process-parcel",
