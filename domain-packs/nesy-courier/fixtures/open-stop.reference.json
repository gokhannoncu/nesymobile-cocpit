{
  "sliceKey": "OPEN_STOP",
  "displayName": "Open stop",
  "businessMeaning": "A courier opens a specific stop from the route list and the app is then working on THAT stop — identified by its business key, never by its position in the list.",
  "notResponsibleFor": [
    "what happens inside the stop once it is open (see PROCESS_PARCEL and COMPLETE_DELIVERY)",
    "the ordering of the stop list",
    "creating the stop — the stop must already exist in the available projection",
    "navigation back out of the stop"
  ],
  "inputSchema": {
    "fields": [
      {
        "name": "stop",
        "type": "entityRef",
        "required": true,
        "entityTypeRef": "STOP",
        "description": "The stop to open, identified by its business key."
      }
    ]
  },
  "outputSchema": {
    "fields": [
      {
        "name": "activeStopMatches",
        "type": "boolean",
        "factKey": "APP.ACTIVE_STOP_MATCHES"
      },
      {
        "name": "landedOnTaskList",
        "type": "boolean",
        "factKey": "UI.TASK_LIST_READY"
      }
    ]
  },
  "preconditions": [
    {
      "kind": "SCREEN_READY",
      "ref": "nesy.route.stop-list",
      "deadlineMs": 25000,
      "onUnmet": "FAIL"
    },
    {
      "kind": "FACT_TRUE",
      "ref": "APP.AVAILABLE_STOPS_LOADED",
      "deadlineMs": 20000,
      "onUnmet": "FAIL"
    },
    {
      "kind": "ENTITY_AVAILABLE",
      "ref": "STOP",
      "deadlineMs": 20000,
      "onUnmet": "FAIL"
    },
    {
      "kind": "SURFACE_ABSENT",
      "ref": "nesy.mandatory-update-dialog",
      "deadlineMs": 5000,
      "onUnmet": "FAIL"
    }
  ],
  "screenRefs": [
    "nesy.route.stop-list",
    "nesy.stop.task-list",
    "nesy.delivery.flow"
  ],
  "surfaceRefs": [
    "nesy.mandatory-update-dialog",
    "nesy.network-dialog"
  ],
  "entityBindings": [
    {
      "entityTypeRef": "STOP",
      "targetRef": "nesy.target.stop-row",
      "role": "The row is identified by the stop's business key, which survives a background re-sort of the list."
    }
  ],
  "targetResolutionRefs": [
    "nesy.target.stop-row"
  ],
  "semanticMacroRef": "nesy.macro.open-stop",
  "macroExpansion": {
