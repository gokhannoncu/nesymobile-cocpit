{
  "sliceKey": "COMPLETE_DELIVERY",
  "displayName": "Complete delivery",
  "businessMeaning": "A courier completes the delivery for a shipment, and the backend eventually records it as completed — whether the device was online at the time or queued the operation.",
  "notResponsibleFor": [
    "payment collection and fiscal receipt printing",
    "recipient signature quality or identity verification",
    "failure/cancel reason codes (separate slices)",
    "how long the backend takes to confirm — only that it confirms within the declared deadline"
  ],
  "inputSchema": {
    "fields": [
      {
        "name": "shipment",
        "type": "entityRef",
        "required": true,
        "entityTypeRef": "SHIPMENT"
      }
    ]
  },
  "outputSchema": {
    "fields": [
      {
        "name": "submitted",
        "type": "boolean",
        "factKey": "APP.DELIVERY_SUBMITTED"
      },
      {
        "name": "confirmed",
        "type": "boolean",
        "factKey": "REMOTE.DELIVERY_CONFIRMED"
      }
    ]
  },
  "preconditions": [
    {
      "kind": "FACT_TRUE",
      "ref": "APP.ACTIVE_STOP_MATCHES",
      "deadlineMs": 20000,
      "onUnmet": "FAIL"
    },
    {
      "kind": "FACT_TRUE",
      "ref": "APP.PARCEL_STATE_PROCESSED",
      "deadlineMs": 20000,
      "onUnmet": "FAIL"
    },
    {
      "kind": "SCREEN_READY",
      "ref": "nesy.delivery.flow",
      "deadlineMs": 20000,
      "onUnmet": "FAIL"
    }
  ],
  "screenRefs": [
    "nesy.delivery.flow"
  ],
  "surfaceRefs": [
    "nesy.payment.surface",
    "nesy.fiscal.surface",
    "nesy.network-dialog"
  ],
  "entityBindings": [
    {
      "entityTypeRef": "SHIPMENT",
      "targetRef": "nesy.target.delivery-complete-button",
      "role": "Scopes the completion and the backend read to one shipment."
    },
    {
      "entityTypeRef": "PENDING_OPERATION",
      "role": "Correlates the queued operation with this delivery."
    }
  ],
  "targetResolutionRefs": [
    "nesy.target.delivery-complete-button"
  ],
  "semanticMacroRef": "nesy.macro.complete-delivery",
  "macroExpansion": {
    "macroRef": "nesy.macro.complete-delivery",
    "authoredBy": "COMPILER",
    "genericIr": {
      "schemaVersion": 2,
      "workflowId": "nesy.reference.complete-delivery",
      "workflowVersion": 1,
      "name": "Complete a delivery, online or queued",
      "source": {
        "kind": "DOMAIN_PACK_EXPANSION",
        "ref": "nesy.macro.complete-delivery"
      },
      "inputs": [
        {
          "name": "consignmentNumber",
          "type": "string",
          "required": true
        }
      ],
      "variables": [
        {
          "name": "completeHandle",
          "type": "string"
        }
      ],
      "steps": [
        {
          "planStepId": "wait-flow",
          "sourceMapRef": "sm-done-1",
          "next": "resolve-complete",
          "timeoutMs": 20000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [],
          "kind": "WAIT_EVENT",
          "factKey": "UI.DELIVERY_FLOW_READY",
          "sourceLane": "UI",
          "requireCorrelation": false,
          "onTimeout": "FAIL"
        },
        {
          "planStepId": "resolve-complete",
          "sourceMapRef": "sm-done-2",
          "next": "tap-complete",
          "timeoutMs": 20000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [
            {
              "capability": "verdict.core.bridge.resolve-target",
              "optional": false
            }
          ],
          "kind": "RESOLVE_TARGET",
          "targetRef": "nesy.target.delivery-complete-button",
          "outputVariable": "completeHandle"
        },
        {
          "planStepId": "tap-complete",
          "sourceMapRef": "sm-done-3",
          "next": "branch-on-queue",
          "timeoutMs": 25000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [
            {
              "capability": "verdict.core.bridge.tap",
              "optional": false
            }
          ],
          "kind": "BRIDGE_ACTION",
          "action": "tap",
          "targetVariable": "completeHandle",
          "entityBinding": {
            "type": "SHIPMENT",
            "id": "run.input.consignmentNumber"
          },
          "continueGate": {
            "allOf": [
              "APP.DELIVERY_SUBMITTED"
            ],
            "deadlineMs": 25000,
            "unknownPolicy": "RETRY"
          }
        },
        {
          "planStepId": "branch-on-queue",
          "sourceMapRef": "sm-done-4",
          "next": null,
          "timeoutMs": 20000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [],
          "kind": "SWITCH",
          "branches": [
            {
              "branchId": "queued-offline",
              "condition": {
                "kind": "comparison",
                "operator": "greaterThan",
                "left": {
                  "kind": "operand",
                  "source": "local.result",
                  "path": "pendingOperation.count"
                },
                "right": {
                  "kind": "literal",
                  "value": 0
                }
              },
              "next": "await-queue-drain"
            }
          ],
          "default": {
            "policy": "GOTO",
            "next": "verify-backend-status"
          },
          "unknownPolicy": "FAIL"
        },
        {
          "planStepId": "await-queue-drain",
          "sourceMapRef": "sm-done-5",
          "next": "verify-backend-status",
          "timeoutMs": 120000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [],
          "kind": "WAIT_EVENT",
          "factKey": "LOCAL.OFFLINE_QUEUE_DRAINED",
          "sourceLane": "LOCAL",
          "requireCorrelation": true,
          "onTimeout": "INCONCLUSIVE",
          "entityBinding": {
            "type": "PENDING_OPERATION",
            "id": "run.input.consignmentNumber"
          }
        },
        {
          "planStepId": "verify-backend-status",
          "sourceMapRef": "sm-done-6",
          "next": "assert-confirmed",
          "timeoutMs": 30000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [
            {
              "capability": "verdict.core.remote.allowlisted-operation",
              "optional": false
            }
          ],
          "kind": "REMOTE_ACTION",
          "spec": {
            "adapterRef": "nesy.backoffice",
            "operationRef": "nesy.backoffice.read-delivery-status",
            "role": "VALIDATION",
            "effectClass": "READ_ONLY",
            "idempotencyClass": "NATURALLY_IDEMPOTENT",
            "inputBindings": [
              {
                "name": "shipment",
                "source": {
                  "kind": "entityRef"
                }
              }
            ],
            "outputFactBindings": [
              {
                "factKey": "REMOTE.DELIVERY_STATUS_COMPLETED",
                "responsePath": "delivery.completed"
              }
            ],
            "timeoutPolicy": {
              "timeoutMs": 20000,
              "maxAttempts": 3,
              "backoffMs": 2000
            },
            "entityBinding": {
              "type": "SHIPMENT",
              "id": "run.input.consignmentNumber"
            },
            "reconciliationPolicy": "NONE",
            "auditPolicy": {
              "recordRequest": true,
              "recordResponse": true,
              "redactFields": [
                "delivery.recipientName"
              ]
            },
            "allowedEnvironments": [
              "qa",
              "staging"
            ]
          }
        },
        {
          "planStepId": "assert-confirmed",
          "sourceMapRef": "sm-done-7",
          "next": null,
          "timeoutMs": 30000,
          "retryPolicy": {
            "maxAttempts": 1,
            "effectClass": "READ_ONLY"
          },
          "capabilityRequirements": [],
          "kind": "ASSERT_FACT",
          "factKey": "REMOTE.DELIVERY_CONFIRMED",
          "expected": true,
          "unknownPolicy": "INCONCLUSIVE",
          "entityBinding": {
            "type": "SHIPMENT",
            "id": "run.input.consignmentNumber"
          },
          "finalOraclePolicy": {
            "requirements": [
              {
                "factKey": "REMOTE.DELIVERY_CONFIRMED",
                "obligation": "REQUIRED",
                "timing": "EVENTUAL",
                "deadlineMs": 120000,
                "onTimeout": "INCONCLUSIVE"
              },
              {
                "factKey": "REMOTE.DELIVERY_STATUS_COMPLETED",
