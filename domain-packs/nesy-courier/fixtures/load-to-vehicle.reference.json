{
  "sliceKey": "LOAD_TO_VEHICLE",
  "displayName": "Load parcel to vehicle",
  "businessMeaning": "A courier takes custody of a parcel at the branch: the app accepts the scanned parcel, the backend creates the task for it, and the parcel appears in the schedule stored on the device.",
  "notResponsibleFor": [
    "whether the parcel SHOULD have been loaded on this route — the backend owns that judgement and answers with a refusal",
    "which delivery time range is correct; the RS picker's default is confirmed, not chosen",
    "the stop ordering the loaded parcel produces",
    "the hand-terminal vehicle-loading screen, which is a different flow with its own endpoint (Task/InsertCargoTransaction)",
    "camera scanning; the typed-entry path is driven because a run cannot present a physical label"
  ],
  "inputSchema": {
    "fields": [
      {
        "name": "scanValue",
        "type": "string",
        "required": true,
        "description": "The value typed into the barcode field: parcel barcode, legacy system barcode or legacy short barcode."
      },
      {
        "name": "shipmentId",
        "type": "string",
        "required": false,
        "description": "Waybill number, used to look the parcel up when the author identified it that way."
      }
    ]
  },
  "outputSchema": {
    "fields": [
      {
        "name": "parcelLoaded",
        "type": "boolean",
        "factKey": "LOCAL.PARCEL_IN_SCHEDULE"
      },
      {
        "name": "scanValue",
        "type": "string"
      }
    ]
  },
  "preconditions": [
    {
      "kind": "FACT_TRUE",
      "ref": "APP.USER_SESSION_AVAILABLE",
      "deadlineMs": 10000,
      "onUnmet": "FAIL"
    },
    {
      "kind": "FACT_TRUE",
      "ref": "APP.SELECTED_ROUTE_OBSERVED",
      "deadlineMs": 10000,
      "onUnmet": "FAIL"
    },
    {
      "kind": "SURFACE_ABSENT",
      "ref": "nesy.mandatory-update-dialog",
      "deadlineMs": 5000,
      "onUnmet": "FAIL"
    }
  ],
  "screenRefs": [
    "nesy.route.stop-list"
  ],
  "surfaceRefs": [],
  "entityBindings": [
    {
      "entityTypeRef": "PARCEL",
      "targetRef": "nesy.target.barcode-input-field",
      "role": "The parcel is identified by the value typed, and the evidence read is narrowed by the same value."
    }
  ],
  "targetResolutionRefs": [
    "nesy.target.manual-barcode-entry",
    "nesy.target.barcode-input-field",
    "nesy.target.barcode-input-confirm",
    "nesy.target.time-slot-confirm",
