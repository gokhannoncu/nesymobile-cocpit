{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/after-file-edit-mark-build.mjs"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop-auto-prod-build.mjs",
        "timeout": 600,
        "loop_limit": 1
      }
    ]
  }
}
