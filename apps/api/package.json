{
  "name": "@nesy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nesy Mobile Backend — Fastify REST API, Socket.io gerçek zamanlı katman",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@nesy/types": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nesy/eslint-config": "workspace:*",
    "@nesy/typescript-config": "workspace:*",
    "@types/node": "^22.10.10",
    "eslint": "^9.39.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
