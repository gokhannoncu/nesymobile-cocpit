{
  "name": "@nesy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nesy Mobile Backend — Fastify REST API, Socket.io gerçek zamanlı katman",
  "scripts": {
    "dev": "node ../../scripts/dev-runner.mjs --port 4001 -- tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node ../../scripts/dev-runner.mjs --port 4001 -- node dist/server.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:verdict-catalog": "tsx src/scripts/seed-verdict-catalog.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/express": "^4.0.2",
    "@fastify/middie": "^9.0.3",
    "@nesy/bridge-client": "workspace:*",
    "@nesy/bridge-contract": "workspace:*",
    "@nesy/bridgeflow-compiler": "workspace:^",
    "@nesy/bridgeflow-executor": "workspace:^",
    "@nesy/control-channels": "workspace:*",
    "@nesy/control-contract": "workspace:*",
    "@nesy/db": "workspace:*",
    "@nesy/domain-pack-contracts": "workspace:^",
    "@nesy/execution-contract": "workspace:*",
    "@nesy/nesy-courier-domain-pack": "workspace:*",
    "@nesy/oracle-engine": "workspace:*",
    "@nesy/platform-paths": "workspace:*",
    "@nesy/types": "workspace:*",
    "@nesy/workflow-contract": "workspace:*",
    "@prisma/client": "^6.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "socket.io": "^4.8.1",
    "undici": "^6",
    "ws": "^8.21.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nesy/eslint-config": "workspace:*",
    "@nesy/typescript-config": "workspace:*",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.10",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.0.5"
  }
}
