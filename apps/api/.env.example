# Nesy Mobile Cockpit — API environment template
# Copy to apps/api/.env and fill credentials from NesyAutomation.

PORT=4001
CORS_ORIGIN=http://localhost:3001
WEB_BASE_URL=http://localhost:3001

NESY_HR_STAGE_BASE_URL=https://nesy-staging-api.overseas.hr
NESY_HR_STAGE_DASHBOARD_BASE_URL=https://nesy-staging.overseas.hr
NESY_HR_PROD_BASE_URL=https://nesy-api.overseas.hr
NESY_HR_PROD_DASHBOARD_BASE_URL=https://nesy.overseas.hr

NESY_RS_STAGE_BASE_URL=https://nesy-staging-api.cityexpress.rs
NESY_RS_STAGE_DASHBOARD_BASE_URL=https://nesy-staging.cityexpress.rs
NESY_RS_PROD_BASE_URL=https://nesy-api.cityexpress.rs
NESY_RS_PROD_DASHBOARD_BASE_URL=https://nesy.cityexpress.rs

NESY_SI_PROD_BASE_URL=https://nesy-api.expressone.si
NESY_SI_PROD_DASHBOARD_BASE_URL=https://nesy.expressone.si

NESY_BA_PROD_BASE_URL=https://nesy-api.expressone.ba
NESY_BA_PROD_DASHBOARD_BASE_URL=https://nesy.expressone.ba

NESY_ME_PROD_BASE_URL=https://nesy-api.expressone.me
NESY_ME_PROD_DASHBOARD_BASE_URL=https://nesy.expressone.me

NESY_AZ_STAGE_BASE_URL=https://nesy-staging-api.starex.az
NESY_AZ_STAGE_DASHBOARD_BASE_URL=https://nesy-staging.starex.az

# Graylog Views Search (one cluster per country; tokens stay server-side)
# Override URL with GRAYLOG_{CC}_BASE_URL if needed. Token required for Run.
GRAYLOG_HR_BASE_URL=https://nesy-graylog.overseas.hr
GRAYLOG_HR_TOKEN=
GRAYLOG_SI_BASE_URL=https://nesy-graylog.expressone.si
GRAYLOG_SI_TOKEN=
GRAYLOG_RS_BASE_URL=https://nesy-graylog.cityexpress.rs
GRAYLOG_RS_TOKEN=
GRAYLOG_SK_BASE_URL=https://graylog.nesy.sps-sro.sk
GRAYLOG_SK_TOKEN=
GRAYLOG_ME_BASE_URL=https://nesy-graylog.expressone.me
GRAYLOG_ME_TOKEN=
GRAYLOG_BA_BASE_URL=https://nesy-graylog.expressone.ba
GRAYLOG_BA_TOKEN=
GRAYLOG_AZ_BASE_URL=https://nesy-graylog.starex.az
GRAYLOG_AZ_TOKEN=
GRAYLOG_BG_BASE_URL=https://nesy-graylog.expressone.bg
GRAYLOG_BG_TOKEN=

# Bridge lab allowlist (comma-separated ADB serials). Empty denies every device (fail-closed).
# Example: VERDICT_BRIDGE_LAB_DEVICES=R6CW400BC8N
VERDICT_BRIDGE_LAB_DEVICES=
